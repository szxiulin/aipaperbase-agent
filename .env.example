# ============================================================
# AIPaperbase Agent 统一配置
# 复制本文件为 .env 并填入真实值；.env 已加入 .gitignore，不会提交。
# ============================================================

# ---- MinerU PDF 解析（仅全文问答需要）----
# 免费 token 在 https://mineru.net/apiManage/token 获取
MINERU_TOKEN=

# ---- Embedding（默认 OpenRouter，可切 SiliconFlow / DashScope）----
# 三个平台都是 OpenAI 兼容 API，换平台只改这三行
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=4096

# ---- Reranker（默认 SiliconFlow，可切 DashScope）----
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# ---- 对话模型（任意 OpenAI 兼容服务；默认 DeepSeek 官方 API）----
# 也可以在网页右上角「设置」里填写，会写回本文件。
# 模型：deepseek-flash（V4.1 Flash，快、便宜，默认）/ deepseek-v4-pro（更强、更慢）
GENERATOR_BASE_URL=https://api.deepseek.com
GENERATOR_API_KEY=
GENERATOR_MODEL=deepseek-flash
# 思考模式开关：enabled（默认开）/ disabled（关，更快）
GENERATOR_THINKING=enabled
# 推理强度（reasoning_effort，仅思考模式开启时生效）：low / high（默认）/ max
GENERATOR_REASONING_EFFORT=high
# 采样参数（仅思考模式关闭时生效；思考模式下这两个参数会被忽略）
GENERATOR_TEMPERATURE=0.7
GENERATOR_TOP_P=1.0
# 输出最大 token 数。注意：思考模式开启时 reasoning 也占这个配额，学术综合回答建议 ≥6000。
# 截断表现为 finish_reason=length（前端会显示"回答被截断"徽标）。
GENERATOR_MAX_TOKENS=8192

# ---- 联网搜索（DeepSeek Search & Fetch API）----
# 是否默认打开对话框里的「联网搜索」开关；每条消息也可以单独开关。
# 2026-11-01（北京时间）前免费，之后每 1,000 次成功调用 $0.75。
WEB_SEARCH_ENABLED=false
# 留空时复用上面的 DeepSeek 对话 Key；对话用其他服务商时可单独填写 DeepSeek Key。
WEB_SEARCH_API_KEY=

# ---- Qdrant 向量库（仅全文问答需要）----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=papers

# ---- LLM 成本保护（防测试死循环跑空余额）----
# 同时最多几个问答任务在跑（超出返回 429）
ASK_MAX_CONCURRENCY=2
# 单个问答任务整体超时（秒），超时强制终止，防单次卡死
ASK_TIMEOUT=600
# 进程级 LLM token 预算（0=不限；服务重启清零）。建议按余额设置一个保守值，如 1000000
# 首次模型请求前读取；修改预算后需重启。已耗尽后阻止新请求，在途请求仍可能超额。
# 仅按 Provider 返回的 usage 结算，不是严格费用上限；未返回 usage 的调用无法准确计费。
GENERATOR_TOKEN_BUDGET=0

# ---- 科研检索 API（research_api 工具类）----
# OpenAlex：无 key 免费额度 $0.10/天（UTC 午夜重置）；配置 mailto 可提高配额
# OPENALEX_API_KEY 留空则匿名调用
OPENALEX_MAILTO=you@example.com
OPENALEX_API_KEY=
# 单个检索任务预算（次），默认 8 次 ≈ $0.01，超出后任务报 budget 用尽
OPENALEX_BUDGET_PER_TASK=8

# ---- 本地检索 ----
# 论文目录 / 科研问答默认返回条数（前端已移除 top_k 输入，改由这里控制；重启生效）
RAG_TOP_K=5
